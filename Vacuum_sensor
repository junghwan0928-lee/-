/* =================================================================
 * SHT31 I2C (로그 참고용, 선택)
 * ================================================================= */
#define SHT31_ADDR 0x44

static void Read_SHT31(float* temperature, float* humidity)
{
    uint8_t cmd[2] = {0x2C, 0x06};
    I2C1_MESSAGE_STATUS st = I2C1_MESSAGE_PENDING;
    I2C1_MasterWrite(cmd, 2, SHT31_ADDR, &st);
    while (st == I2C1_MESSAGE_PENDING) { ; }
    __delay_ms(20);

    uint8_t buf[6] = {0};
    st = I2C1_MESSAGE_PENDING;
    I2C1_MasterRead(buf, 6, SHT31_ADDR, &st);
    while (st == I2C1_MESSAGE_PENDING) { ; }

    if (st == I2C1_MESSAGE_COMPLETE) {
        uint16_t rt = ((uint16_t)buf[0] << 8) | buf[1];
        uint16_t rh = ((uint16_t)buf[3] << 8) | buf[4];
        *temperature = -45.0f + 175.0f * (rt / 65535.0f);
        *humidity    = 100.0f * (rh / 65535.0f);
    } else {
        *temperature = -999.0f;
        *humidity    = -999.0f;
    }
}


