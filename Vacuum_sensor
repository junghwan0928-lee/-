/* =================================================================
 * 측정 루틴(주기: SAMPLE_PERIOD_MS)
 *  - 1) 센서 ADC (AIN0-AIN1, diff)
 *  - 2) 메인 출력 피드백 ADC (AIN2-GND, single)
 *  - 3) 캘리브레이션 기반 offset 갱신 후 DAC 출력
 * ================================================================= */
static void process_sensor_measurements(void)
{
    /* 1) 센서측 ADC 읽기 */
    int32_t dec_sensor = 0;
    float   v_adc_sensor = 0.0f;
    if (!SGM_ReadSingle_ADC(SGM_MUX_AIN0_AIN1_DIFF, &dec_sensor, &v_adc_sensor)) {
        UART_PrintString("SGM ADC(sensor) timeout / invalid sample\r\n");
        return;
    }

    /* 필터 적용 */
    g_dec_filt = filter_dec_with_delay(dec_sensor);

    /* 초기 RAW 샘플 N개는 버림 (출력/보정/로그에 사용하지 않음) */
    if (g_raw_discard_remaining > 0) {
        g_raw_discard_remaining--;
        return;
    }

    /* 사용자 설정 비트 뷰 */
    int32_t view_raw_1 = (int32_t)(g_dec_filt >> COARSE_SHIFT_1);
    if (!g_view_init) {
        g_view_ema = view_raw_1;
        g_view_init = true;
    } else {
        g_view_ema = (int32_t)((1.0f - 0.30f) * (float)g_view_ema + 0.30f * (float)view_raw_1);
    }
    int32_t view_filt_1 = (int32_t)lrintf((float)g_view_ema);

    /* 뷰2: 20bit  */
    int32_t view_raw_2 = (int32_t)(g_dec_filt >> COARSE_SHIFT_2);
    if (!g_view2_init) {
        g_view2_ema = view_raw_2;
        g_view2_init = true;
    } else {
        g_view2_ema = (int32_t)((1.0f - 0.30f) * (float)g_view2_ema + 0.30f * (float)view_raw_2);
    }
    int32_t view_filt_2 = (int32_t)lrintf((float)g_view2_ema);
    
    
    int32_t view_raw_3 = (int32_t)(g_dec_filt >> COARSE_SHIFT_3);
    if (!g_view3_init) {
        g_view3_ema = view_raw_3;
        g_view3_init = true;
    } else {
        g_view3_ema = (int32_t)((1.0f - 0.30f) * (float)g_view3_ema + 0.30f * (float)view_raw_3);
    }
    int32_t view_filt_3 = (int32_t)lrintf((float)g_view3_ema);



    /* DEC → Torr */
    int32_t dec_for_lut = g_dec_filt;
    g_torr_est = estimate_torr_from_dec(dec_for_lut);

    /* 이상적인 최종 출력 (목표값, 고객이 보는 전압 기준) */
    float vout_target = g_torr_est * TORR_TO_OPAMP_V_PER_TORR;

    /* 2) 메인 출력 피드백 한번 측정 */
    int32_t dec_fb = 0;
    float   v_adc_fb = 0.0f;
    bool    fb_ok = SGM_ReadSingle_ADC(SGM_MUX_AIN2_GND_SINGLE, &dec_fb, &v_adc_fb);

    float vout_meas = 0.0f;
    if (fb_ok) {
        vout_meas      = v_adc_fb * FB_ADC_TO_OPAMP_GAIN;
        g_fb_last_vout = vout_meas;
        g_fb_last_valid= true;
    } else {
        g_fb_last_valid = false;
        UART_PrintString("SGM ADC(feedback) timeout / invalid sample\r\n");
    }

#if FB_CAL1_ENABLE
    /* 100Torr 1점 캘리브레이션 (현재는 비활성 상태) */
    feedback_onepoint_calibration(g_torr_est, vout_target, fb_ok, vout_meas);
#endif

    /* RAW 장기 드리프트 보정 (안정 Torr 구간에서만 작동) */
    drift_correction_update(g_torr_est, vout_target, fb_ok, vout_meas);

    /* 3) Torr → DAC (이론값 + offset LUT 적용) */
    bool  cl_lo = false, cl_hi = false;
    float v_dac_raw = torr_to_vdac(g_torr_est, &cl_lo, &cl_hi);

    float applied_gain = 1.0f, applied_offs = 0.0f;
    int   matched_gidx = -1,    matched_oidx = -1;

    float v_dac = apply_dac_gain_offset_selective(
        g_torr_est,
        v_dac_raw,
        &applied_gain, &applied_offs,
        &matched_gidx, &matched_oidx
    );

#if DRIFT_CORR_ENABLE
    /* 드리프트 보정 offset 추가 */
    v_dac += g_drift_vdac_offset;
    if (v_dac < 0.0f) v_dac = 0.0f;
    if (v_dac > VREF_V) v_dac = VREF_V;
#endif

    DAC_WriteVoltage_V(v_dac);

    /* SHT31 온도/습도 (옵션) */
    float t_ref = -999.0f, rh_ref = -1.0f;
    Read_SHT31(&t_ref, &rh_ref);

    /* SGM 내부 온도센서 (원시값) */
    int32_t dec_temp = 0;
    float   v_temp   = 0.0f;
    bool    temp_ok  = false;
#if SGM_TEMP_ENABLE
    temp_ok = SGM_Read_Temp(&dec_temp, &v_temp);
#endif

    /* 1V(100Torr) 구간 offset 값 조회 */
    int   idx_v = find_offset_index_for_torr(FB_CAL1_REF_TORR);
    float off_v = 0.0f;
    if (idx_v >= 0) {
        off_v = offset_torr_offset_v[idx_v];
    }

    /* FB 상태 문자열 구성 */
    const char* fb_valid_str = fb_ok ? "OK" : "NG";

    /* 자동 보정은 제거, CAL 전용 알고리즘 */
    const char* fb_alg_str = "ONLY";

    const char* fb_cal_str = "NA";
#if FB_CAL1_ENABLE
    fb_cal_str = g_cal1_done ? "OK" : "WAIT";
#endif

    const char* temp_state_str = "DIS";
#if SGM_TEMP_ENABLE
    temp_state_str = temp_ok ? "OK" : "NG";
#endif

    UART_Printf(
        "\r\n"
        "\r\n[ADC] Raw24:%ld Filt24:%ld | Raw%d:%ld Filt%d:%ld\r\n"
        "      Raw%d:%ld Filt%d:%ld | Raw%d:%ld Filt%d:%ld\r\n"
        "      ADC_Sensor=%.3fmV | DAC Output= %.4fV | Main Output= %.4fV | Torr=%.4f\r\n"
        "      Feed Back:%s cal=%s cal_ref=%.1fV | ADC_AIN2= %.4fV | Offset= %.6fV \r\n"
        "      SHT31_T= %.2fC RH= %.1f%% | ADC_T= %.2fC\r\n",
        (long)dec_sensor,
        (long)g_dec_filt,

        VIEW_BITS_1, (long)view_raw_1,        
        VIEW_BITS_1, (long)view_filt_1,        

        VIEW_BITS_2, (long)view_raw_2,         
        VIEW_BITS_2, (long)view_filt_2,
            
        VIEW_BITS_3, (long)view_raw_3,         
        VIEW_BITS_3, (long)view_filt_3,    

        (double)(v_adc_sensor * 1000.0f),

        (double)v_dac_raw,
        (double)(v_dac_raw * OPAMP_GAIN),
        (double)g_torr_est,
            
        fb_valid_str,
        fb_cal_str,
        (double)FB_CAL1_REF_TORR_DEBUG,
        (double)v_adc_fb,
        (double)off_v,            
            
        (double)t_ref,
        (double)rh_ref,
        (double)v_temp
    );
}


/* =================================================================
 * main
 * ================================================================= */
int main(void)
{
    SYSTEM_Initialize();
    UART1_Initialize();
    SPI1_Initialize();   // ★ ADC(SGM)
    SPI2_Initialize();   // ★ DAC
    I2C1_Initialize();

    /* LED 핀 초기화 */
    LED1_TRIS = 0;
    LED2_TRIS = 0;
    LED3_TRIS = 0;

    LED1_Off();
    LED2_Off();
    LED3_Off();

    /* SGM DRDY 핀 초기화 (보드에 맞게 조정) */
    SGM_DRDY_TRIS = 1;

#ifdef ANSELAbits
    ANSELAbits.ANSA0 = 0; // 필요시 RA0를 디지털로
#elif defined(ANSELA)
    ANSELA &= ~(1u<<0);
#endif

#ifdef SGM_NCS_TRIS
    /* ADC CS 핀 항상 LOW로 유지 (하드웨어 설계에 따라 다를 수 있음) */
    SGM_NCS_TRIS = 0;
    SGM_NCS_LAT  = 0;
#endif

    DAC_SPI_Init();

    __delay_ms(10);

#if (DAC_BOOT_TEST_MV >= 0)
    DAC_WriteCode16(Dac_code_from_mV((uint16_t)DAC_BOOT_TEST_MV, VREF_MV));
#endif

    /* SGM Single-Shot 초기화 */
    SGM_Init_SingleShot();

    /* 부팅 시 0.25V → 1.0V 기준 1점 CAL 수행 (Torr 무관) */
    Feedback_BootCal_1V();

    /* 매핑 정보 출력 */
    printf("Torr range = %.3f ~ %.3f \r\n", (double)TORR_DAC_MIN, (double)TORR_DAC_MAX);
    printf("DAC VREF = %.3f V, OPAMP_GAIN = %.3f x  -> OPAMP FS ≈ %.3f V (maps to max Torr %.3f)\r\n",
           (double)VREF_V, (double)OPAMP_GAIN, (double)(VREF_V * OPAMP_GAIN), (double)TORR_DAC_MAX);
    printf("Feedback mode: CAL1 only (auto-offset disabled)\r\n");
    printf("CAL1(1V) enable=%d, ref=%.1fTorr, tol=%.1fTorr, stable=%ums, apply<=%.1fTorr\r\n",
           FB_CAL1_ENABLE,
           (double)FB_CAL1_REF_TORR,
           (double)FB_CAL1_REF_TORR_TOL,
           (unsigned)FB_CAL1_STABLE_TIME_MS,
           (double)FB_CAL1_APPLY_MAX_TORR);
    printf("RAW discard count = %u, median=%s (window=%d)\r\n",
           (unsigned)RAW_DISCARD_COUNT,
           RAW_MEDIAN_ENABLE ? "ON" : "OFF",
           (int)RAW_MEDIAN_WINDOW);

#if DEMO_OUTPUT_SEQUENCE_ENABLE
    /* 필요 시 부팅 직후 1V->0.5V->0.1V 데모 출력 */
    DEMO_Output_1V_0p5V_0p1V();
#endif

    while (1) {
        process_sensor_measurements();

        __delay_ms(1000);   // 실측 주기
        g_elapsed_ms += SAMPLE_PERIOD_MS;
        if (!g_filter_active && g_elapsed_ms >= FILTER_DELAY_MS) {
            g_filter_active = true;
        }
    }
    return 0;
}
