/* =================================================================
 * SPI 모드 설정
 *  - ADC(SGM) : SPI1, Mode-1 (CKP=0, CKE=0, SMP=1)
 *  - DAC      : SPI2, Mode-0 (CKP=0, CKE=1, SMP=0) → 보드 기본
 * ================================================================= */
static inline void SPI1_SetMode(uint8_t ckp, uint8_t cke, uint8_t smp){

#if defined(SPI1STATbits) && defined(SPI1CON1bits) && defined(SPI1BUF)
    SPI1STATbits.SPIEN = 0;
    SPI1CON1bits.CKP = ckp; SPI1CON1bits.CKE = cke; SPI1CON1bits.SMP = smp;
    (void)SPI1BUF; SPI1STATbits.SPIROV = 0; SPI1STATbits.SPIEN = 1;
#elif defined(SPI1STATLbits) && defined(SPI1CON1Lbits) && defined(SPI1BUFL)
    SPI1STATLbits.SPIEN = 0;
    SPI1CON1Lbits.CKP = ckp; SPI1CON1Lbits.CKE = cke; SPI1CON1Lbits.SMP = smp;
    (void)SPI1BUFL; SPI1STATLbits.SPIROV = 0; SPI1STATLbits.SPIEN = 1;
#elif defined(SPI1CONbits) && defined(SPI1BUF) && defined(SPI1STATbits)
    SPI1CONbits.ON = 0;
    SPI1CONbits.CKP = ckp; SPI1CONbits.CKE = cke; SPI1CONbits.SMP = smp;
    volatile uint16_t d = SPI1BUF; (void)d; SPI1STATbits.SPIROV = 0; SPI1CONbits.ON = 1;
#endif
}
static inline void SPI1_SetFor_SGM(void){ SPI1_SetMode(0,0,1); }

static inline void SPI2_SetFor_DAC(void){
#if defined(SPI2STATbits) && defined(SPI2CON1bits) && defined(SPI2BUF)
    SPI2STATbits.SPIEN = 0;
    SPI2CON1bits.CKP = 0; SPI2CON1bits.CKE = 1; SPI2CON1bits.SMP = 0;
    (void)SPI2BUF; SPI2STATbits.SPIROV = 0; SPI2STATbits.SPIEN = 1;
#elif defined(SPI2STATLbits) && defined(SPI2CON1Lbits) && defined(SPI2BUFL)
    SPI2STATLbits.SPIEN = 0;
    SPI2CON1Lbits.CKP = 0; SPI2CON1Lbits.CKE = 1; SPI2CON1Lbits.SMP = 0;
    (void)SPI2BUFL; SPI2STATLbits.SPIROV = 0; SPI2STATLbits.SPIEN = 1;
#elif defined(SPI2CONbits) && defined(SPI2BUF) && defined(SPI2STATbits)
    SPI2CONbits.ON = 0;
    SPI2CONbits.CKP = 0; SPI2CONbits.CKE = 1; SPI2CONbits.SMP = 0;
    volatile uint16_t d = SPI2BUF; (void)d; SPI2STATbits.SPIROV = 0; SPI2CONbits.ON = 1;
#endif
}


/* =================================================================
 * 선택적 DAC 출력 보정 (구간 gain/offset)
 *  - gain은 사용 안 함, offset은 캘리브레이션 기반으로 갱신  // [FB]
 * ================================================================= */
#define DAC_OUTPUT_GAIN_ENABLE     0
#define DAC_OUTPUT_OFFSET_ENABLE   1    // ★ offset 항상 사용 (0으로 끄면 LUT offset 전체 비활성)

#define DAC_GAIN_PAIR_COUNT        0

static const float gain_torr_choose[DAC_GAIN_PAIR_COUNT] = { 100.0f };
static const float gain_torr_gain  [DAC_GAIN_PAIR_COUNT] = { 0.0010f };

#ifndef DAC_OFFSET_PAIR_COUNT
#define DAC_OFFSET_PAIR_COUNT 30
#endif

static const float offset_torr_choose[DAC_OFFSET_PAIR_COUNT]   = {
    0.10f,
    0.20f,
    0.30f,
    0.40f,
    0.50f,
    0.60f,
    0.70f,
    0.80f,
    0.90f,

    1.0f,
    2.0f,
    3.0f,
    4.0f,
    5.0f,
    6.0f,
    7.0f,
    8.0f,
    9.0f,

    10.0f,
    50.0f,   // #20

    100.0f,
    200.0f,
    300.0f,
    400.0f,
    500.0f,
    600.0f,
    700.0f,
    800.0f,
    900.0f,
   1000.0f,    // #30
};

/*  ★ 초기값은 모두 0에서 시작 → 캘리브레이션 결과로 채워나감   */
static float offset_torr_offset_v[DAC_OFFSET_PAIR_COUNT] = { 0.0f };



/* =================================================================
 * DAC Gain/Offset 적용 (gain은 끄고, offset은 LUT + 캘리브레이션)
 * ================================================================= */
static inline float apply_dac_gain_offset_selective(
    float p_torr,
    float vdac_in,
    float* gain_out,
    float* offset_out,
    int* matched_gain_idx_out,
    int* matched_offset_idx_out
){
    float g = 1.0f, o = 0.0f;
    int gi=-1, oi=-1;

#if (DAC_OUTPUT_GAIN_ENABLE == 1)
    for (int i = 0; i < DAC_GAIN_PAIR_COUNT; ++i) {
        float start = gain_torr_choose[i];
        float end   = (i+1 < DAC_GAIN_PAIR_COUNT) ? gain_torr_choose[i+1] : TORR_DAC_MAX + 1e-9f;
        if (p_torr >= start && p_torr < end) { g = gain_torr_gain[i]; gi=i; break; }
    }
#endif

#if (DAC_OUTPUT_OFFSET_ENABLE == 1)
    for (int j = 0; j < DAC_OFFSET_PAIR_COUNT; ++j) {
        float start = offset_torr_choose[j];
        float end   = (j+1 < DAC_OFFSET_PAIR_COUNT) ? offset_torr_choose[j+1] : TORR_DAC_MAX + 1e-9f;
        if (p_torr >= start && p_torr < end) { o = offset_torr_offset_v[j]; oi=j; break; }
    }
#endif

    if (gain_out)   *gain_out   = g;
    if (offset_out) *offset_out = o;
    if (matched_gain_idx_out)   *matched_gain_idx_out = gi;
    if (matched_offset_idx_out) *matched_offset_idx_out = oi;

    float v = vdac_in * g + o;
    if (v < 0.0f) v = 0.0f;
    const float v_max_safe = VREF_V * (65534.0f / 65535.0f);
    if (v > v_max_safe) v = v_max_safe;
    return v;
}


/* =================================================================
 * DAC (SPI2)
 * ================================================================= */
static void DAC_SPI_Init(void)
{
    DAC_CS_TRIS = 0;
    DAC_CS_LAT  = 1;   // 비활성
}
static inline void DAC_WriteCode16(uint16_t code)
{
    SPI2_SetFor_DAC();
    DAC_CS_LAT = 0;
    __delay_us(1);
    (void)SPI2_Exchange8bit((uint8_t)(code >> 8));
    (void)SPI2_Exchange8bit((uint8_t)(code & 0xFF));
    __delay_us(1);
    DAC_CS_LAT = 1;
    __delay_us(3);
}
static inline uint16_t Dac_code_from_mV(uint16_t vout_mV, uint16_t vref_mV)
{
    if (vout_mV >= vref_mV) return 0xFFFFu;
    uint32_t num = (uint32_t)vout_mV * 65535u + (vref_mV / 2);
    return (uint16_t)(num / vref_mV);
}
static inline void DAC_WriteVoltage_V(float v_out_volt)
{
    float v = v_out_volt;
    if (v < 0.0f) v = 0.0f;
    const float v_max_safe = VREF_V * (65534.0f / 65535.0f);
    if (v > v_max_safe) v = v_max_safe;
    uint32_t code32 = (uint32_t)lrintf((v / VREF_V) * 65535.0f);
    if (code32 > 0xFFFFu) code32 = 0xFFFFu;
    DAC_WriteCode16((uint16_t)code32);
}




/* =================================================================
 * SGM52410S (ADC on SPI1) – 단발(Single-Shot) 모드로 동작
 * -----------------------------------------------------------------
 *  - MUX:
 *      AIN0-AIN1 : 센서 입력 (diff)
 *      AIN2-GND  : 메인 출력 피드백 (single)
 * ================================================================= */
#define SGM_DR_100SPS                0b100
#define SGM_PGA_2V048                0b010

#define SGM_MUX_AIN0_AIN1_DIFF       0b000   // AIN0(+) - AIN1(-)
#define SGM_MUX_AIN2_GND_SINGLE      0b110   // AIN2(+) - GND

#define SGM_PGA                      2.048f  // FSR = ±2.048V

#define SGM_TEMP_ENABLE              1       // 1: 내부 온도센서 원시값까지 로그출력

static uint16_t g_sgm_cfg2 = 0;
static bool     g_sgm_inited = false;

static uint16_t SGM_BuildConfig1_ADC(uint8_t mux_sel, bool singleShot, bool start_now)
{
    uint16_t cfg = 0;

    cfg |= ((uint16_t)(mux_sel & 0x7)        << 12); // MUX[2:0]
    cfg |= ((uint16_t)(SGM_PGA_2V048 & 0x7)  << 9 ); // PGA[2:0]
    cfg |= ((uint16_t)(singleShot ? 1u : 0u) << 8 ); // MODE (1 = single-shot)
    cfg |= ((uint16_t)(SGM_DR_100SPS & 0x7)  << 5 ); // DR[2:0]
    cfg |= ((uint16_t)0u                     << 4 ); // TS_MODE = 0 (ADC)
    cfg |= ((uint16_t)1u                     << 3 ); // PULL_UP_EN = 1
    cfg |= ((uint16_t)0b01u                  << 1 ); // NOP[1:0] = 01 (valid)
    cfg |= 1u;                                      // D0 = 1 (reserved)

    if (start_now) {
        cfg |= (1u << 15);                          // SS = 1 → 변환 시작
    }
    return cfg;
}




