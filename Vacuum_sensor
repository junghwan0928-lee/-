/* =================================================================
 * Torr → LUT index 찾기 (offset 테이블용)
 * ================================================================= */
static int find_offset_index_for_torr(float p_torr)
{
    for (int j = 0; j < DAC_OFFSET_PAIR_COUNT; ++j) {
        float start = offset_torr_choose[j];
        float end   = (j+1 < DAC_OFFSET_PAIR_COUNT) ? offset_torr_choose[j+1] : TORR_DAC_MAX + 1e-9f;
        if (p_torr >= start && p_torr < end) {
            return j;
        }
    }
    return -1;
}


#if FB_CAL1_ENABLE
/* =================================================================
 * 100Torr(1V) 구간에서 1점 캘리브레이션
 *  - Torr가 100±TOL 범위에 일정 시간 머무르면
 *    Vout_target - Vout_meas 를 이용해 DAC offset 산출
 *  - 산출된 offset은 FB_CAL1_APPLY_MAX_TORR(<=100Torr)까지 공통 적용
 * ================================================================= */
static void feedback_onepoint_calibration(float p_torr,
                                          float vout_target,
                                          bool  fb_ok,
                                          float vout_meas)
{
    if (g_cal1_done) {
        return;
    }

    if (!fb_ok) {
        g_cal1_stable_ms = 0;
        return;
    }

    float dtorr = p_torr - FB_CAL1_REF_TORR;
    if (dtorr < 0.0f) dtorr = -dtorr;

    if (dtorr <= FB_CAL1_REF_TORR_TOL) {
        if (g_cal1_stable_ms < FB_CAL1_STABLE_TIME_MS) {
            g_cal1_stable_ms += SAMPLE_PERIOD_MS;
        }

        if (g_cal1_stable_ms >= FB_CAL1_STABLE_TIME_MS) {
            float err_vout = vout_target - vout_meas;   // (+)면 출력이 모자람
            float off_vdac = err_vout / OPAMP_GAIN;     // DAC 전압 기준 보정값

            if (off_vdac >  FB_CAL1_MAX_OFFSET_VDAC_ABS) off_vdac =  FB_CAL1_MAX_OFFSET_VDAC_ABS;
            if (off_vdac < -FB_CAL1_MAX_OFFSET_VDAC_ABS) off_vdac = -FB_CAL1_MAX_OFFSET_VDAC_ABS;

            g_cal1_vdac_offset = off_vdac;
            g_cal1_done        = true;

            /* 저압 구간 전체에 동일 offset 적용 */
            for (int j = 0; j < DAC_OFFSET_PAIR_COUNT; ++j) {
                if (offset_torr_choose[j] <= FB_CAL1_APPLY_MAX_TORR) {
                    offset_torr_offset_v[j] = g_cal1_vdac_offset;
                }
            }

#if FB_CAL1_DEBUG_PRINT
            UART_Printf(
                "\r\n"
                "[CAL] DONE: Torr=%.3f, Vout_meas=%.6fV, target=%.6fV -> off_dac=%.6fV (<=%.1fTorr)\r\n",
                (double)p_torr,
                (double)vout_meas,
                (double)vout_target,
                (double)g_cal1_vdac_offset,
                (double)FB_CAL1_APPLY_MAX_TORR
            );
#endif
        }
    } else {
        g_cal1_stable_ms = 0;
    }
}
#endif


/* =================================================================
 * 부팅 시 DAC=0.25V → 메인 출력 1.0V 기준 1점 CAL
 *  - Torr와 무관, 전압 기준으로만 offset 계산
 *  - 계산된 offset을 FB_BOOTCAL_APPLY_MAX_TORR 이하 구간 LUT에 공통 적용
 * ================================================================= */
static void Feedback_BootCal_1V(void)
{
#if FB_BOOTCAL_ENABLE

    /* 0.25V 명령 (OPAMP x4 → 1V 기대) */
    float v_dac_cmd = clampf(FB_BOOTCAL_DAC_CMD_V, 0.0f, VREF_V);
    DAC_WriteVoltage_V(v_dac_cmd);

    __delay_ms(500);

    float sum_vout = 0.0f;
    int   valid    = 0;

    for (int i = 0; i < FB_BOOTCAL_AVG_COUNT; ++i) {
        int32_t dec_fb   = 0;
        float   v_adc_fb = 0.0f;

        if (SGM_ReadSingle_ADC(SGM_MUX_AIN2_GND_SINGLE, &dec_fb, &v_adc_fb)) {
            float vout_meas = v_adc_fb * FB_ADC_TO_OPAMP_GAIN;
            sum_vout += vout_meas;
            valid++;
        }

        __delay_ms(FB_BOOTCAL_DELAY_MS);
    }

    if (valid > 0) {
        float vout_avg = sum_vout / (float)valid;

        float err_vout = FB_BOOTCAL_TARGET_VOUT - vout_avg;   // (+)면 출력이 모자람
        float off_dac  = err_vout / OPAMP_GAIN;               // DAC 전압 기준 offset

        off_dac *= FB_BOOTCAL_OFFSET_SCALE;
        
        if (off_dac >  FB_BOOTCAL_MAX_OFFSET_VDAC_ABS) off_dac =  FB_BOOTCAL_MAX_OFFSET_VDAC_ABS;
        if (off_dac < -FB_BOOTCAL_MAX_OFFSET_VDAC_ABS) off_dac = -FB_BOOTCAL_MAX_OFFSET_VDAC_ABS;

        for (int j = 0; j < DAC_OFFSET_PAIR_COUNT; ++j) {
            if (offset_torr_choose[j] <= FB_BOOTCAL_APPLY_MAX_TORR) {
                offset_torr_offset_v[j] = off_dac;
            }
        }

        UART_Printf(
            "\r\n[BOOTCAL] 1V: Vout_avg=%.6fV, target=%.6fV, off_dac=%.6fV (<=%.1fTorr)\r\n",
            (double)vout_avg,
            (double)FB_BOOTCAL_TARGET_VOUT,
            (double)off_dac,
            (double)FB_BOOTCAL_APPLY_MAX_TORR
        );
    } else {
        UART_PrintString("\r\n[BOOTCAL] FB ADC sample 없음 → CAL 스킵\r\n");
    }

#endif
}


/* =================================================================
 * RAW 드리프트 보정 업데이트
 *  - torr_now, vout_meas: 현재 Torr 추정 / 메인 출력
 *  - vout_target: 현재 이론적으로 나와야 하는 출력 (Torr 기반)
 *  - fb_ok: AIN2 피드백 정상 여부
 * ================================================================= */
static void drift_correction_update(float torr_now,
                                    float vout_target,
                                    bool  fb_ok,
                                    float vout_meas)
{
#if DRIFT_CORR_ENABLE

    if (!fb_ok) {
        g_drift_active        = false;
        g_drift_stable_ms     = 0;
        g_drift_have_last     = false;
        g_drift_vdac_offset   = 0.0f;
        return;
    }

    if (!g_drift_have_last) {
        g_drift_last_torr = torr_now;
        g_drift_last_vout = vout_meas;
        g_drift_have_last = true;
        g_drift_stable_ms = 0;
        return;
    }

    float dtorr = torr_now - g_drift_last_torr;
    if (dtorr < 0.0f) dtorr = -dtorr;

    float dvout = vout_meas - g_drift_last_vout;
    if (dvout < 0.0f) dvout = -dvout;

    /* 급격한 변화 → 사용자 토르 조작으로 간주, 드리프트 보정 OFF + offset 리셋 */
    if (dtorr > DRIFT_STABLE_TORR_THRESH * 5.0f ||
        dvout > DRIFT_STABLE_VOUT_STEP_V)
    {
        g_drift_active        = false;
        g_drift_stable_ms     = 0;
        g_drift_vdac_offset   = 0.0f;

        g_drift_ref_torr      = torr_now;
        g_drift_ref_vout      = vout_meas;
        g_drift_last_torr     = torr_now;
        g_drift_last_vout     = vout_meas;
        return;
    }

    /* 안정 구간 누적 시간 계산 */
    if (dtorr < DRIFT_STABLE_TORR_THRESH &&
        dvout < DRIFT_STABLE_VOUT_STEP_V) {
        if (g_drift_stable_ms < 0xFFFFFFFFu - SAMPLE_PERIOD_MS) {
            g_drift_stable_ms += SAMPLE_PERIOD_MS;
        }
    } else {
        g_drift_stable_ms = 0;
    }

    /* 충분히 안정되면 드리프트 보정 ON */
    if (!g_drift_active && g_drift_stable_ms >= DRIFT_STABLE_TIME_MS) {
        g_drift_active        = true;
        g_drift_ref_torr      = torr_now;
        g_drift_ref_vout      = vout_meas;
        g_drift_vdac_offset   = 0.0f;
    }

    g_drift_last_torr = torr_now;
    g_drift_last_vout = vout_meas;

    if (!g_drift_active) {
        return;
    }

    float ref = g_drift_ref_vout;
    if (ref < 0.1f) ref = 0.1f;

    float band = ref * DRIFT_MAX_RATIO;

    float err  = vout_meas - g_drift_ref_vout;
    float sign = (err >= 0.0f) ? 1.0f : -1.0f;
    float mag  = (err >= 0.0f) ? err : -err;

    if (mag <= band) {
        return;
    }

    float err_ex = mag - band;

    float k = (float)SAMPLE_PERIOD_MS / (float)DRIFT_CORR_TC_MS;
    if (k > 1.0f) k = 1.0f;

    float delta_vdac = (err_ex / OPAMP_GAIN) * k;

    if (sign > 0.0f) {
        g_drift_vdac_offset -= delta_vdac;
    } else {
        g_drift_vdac_offset += delta_vdac;
    }

    if (g_drift_vdac_offset >  DRIFT_MAX_VDAC_OFFSET) g_drift_vdac_offset =  DRIFT_MAX_VDAC_OFFSET;
    if (g_drift_vdac_offset < -DRIFT_MAX_VDAC_OFFSET) g_drift_vdac_offset = -DRIFT_MAX_VDAC_OFFSET;

#endif
}


#if DEMO_OUTPUT_SEQUENCE_ENABLE
/* ================================================================
 * DEMO : 1V에서 offset 한 번 잡고 → 그 offset 고정한 채
 *        1V → 0.1V → 0.01V → 0.001V 를 계속 반복 출력
 * ================================================================ */
static void DEMO_Output_1V_0p5V_0p1V(void)
{
    const float demo_torrs[] = { 100.0f, 1.0f, 0.10f, 100.0f };   // 0.5V, 0.01V, 0.001V(예시)
    const int   n_demo       = 4;

    /* STEP 0: offset 테이블 초기화 */
    for (int j = 0; j < DAC_OFFSET_PAIR_COUNT; ++j) {
        offset_torr_offset_v[j] = 0.0f;
    }

    /* STEP 1: 1V(100Torr) 출력 (offset=0 상태) */
    float torr_1v = demo_torrs[0];     // 100Torr
    bool  cl_lo = false, cl_hi = false;

    float vdac_raw_1v = torr_to_vdac(torr_1v, &cl_lo, &cl_hi);

    float g_dummy = 1.0f, o_dummy = 0.0f;
    int   gi_dummy = -1, oi_dummy = -1;

    float vdac_1v = apply_dac_gain_offset_selective(
        torr_1v,
        vdac_raw_1v,
        &g_dummy, &o_dummy,
        &gi_dummy, &oi_dummy
    );

    DAC_WriteVoltage_V(vdac_1v);

    UART_Printf(
        "[CAL] 1V pre-output: Torr=%.1f, DAC_raw=%.6fV, DAC=%.6fV, Vout_est=%.6fV\r\n",
        (double)torr_1v,
        (double)vdac_raw_1v,
        (double)vdac_1v,
        (double)(vdac_1v * OPAMP_GAIN)
    );

    __delay_ms(DEMO_OUTPUT_HOLD_MS);

    /* STEP 2: 피드백 ADC(AIN2)로 실제 OUTPUT 측정 → 1V 기준 offset 계산 */
    int32_t dec_fb = 0;
    float   v_adc_fb = 0.0f;

    if (!SGM_ReadSingle_ADC(SGM_MUX_AIN2_GND_SINGLE, &dec_fb, &v_adc_fb)) {
        UART_PrintString("[CAL] FB ADC ERROR → offset \r\n");
        return;
    }

    float vout_meas   = v_adc_fb * FB_ADC_TO_OPAMP_GAIN;               // 실제 OUTPUT 전압
    float vout_target = torr_1v * TORR_TO_OPAMP_V_PER_TORR;            // 이론 1.0V

    float err_vout = vout_target - vout_meas;                          // (+)면 출력이 모자람
    float off_vdac = err_vout / OPAMP_GAIN;                            // DAC 기준 offset

    if (off_vdac >  FB_CAL1_MAX_OFFSET_VDAC_ABS) off_vdac =  FB_CAL1_MAX_OFFSET_VDAC_ABS;
    if (off_vdac < -FB_CAL1_MAX_OFFSET_VDAC_ABS) off_vdac = -FB_CAL1_MAX_OFFSET_VDAC_ABS;

    /* STEP 3: 0.1~100Torr 구간 전체에 동일 offset 적용 */
    for (int j = 0; j < DAC_OFFSET_PAIR_COUNT; ++j) {
        if (offset_torr_choose[j] <= FB_CAL1_APPLY_MAX_TORR) {
            offset_torr_offset_v[j] = off_vdac;
        }
    }

    UART_Printf(
        "[CAL] 1V offset : Vout_meas=%.6fV, target=%.6fV, off_dac=%.6fV (<=%.1fTorr)\r\n",
        (double)vout_meas,
        (double)vout_target,
        (double)off_vdac,
        (double)FB_CAL1_APPLY_MAX_TORR
    );

    /* STEP 4: offset 고정한 상태로 1V→0.5V→0.1V 반복 출력 */

    while (1) {
        for (int i = 0; i < n_demo; ++i) {
            float t = demo_torrs[i];
            bool  lo = false, hi = false;

            float v_raw  = torr_to_vdac(t, &lo, &hi);    // 이론 DAC 전압
            float g2 = 1.0f, o2 = 0.0f;
            int   gi2 = -1,  oi2 = -1;

            float v_dac2 = apply_dac_gain_offset_selective(
                t,
                v_raw,
                &g2, &o2,
                &gi2, &oi2
            );

            DAC_WriteVoltage_V(v_dac2);

            UART_Printf(
                "[DEMO] OUT Torr=%.3f → DAC_raw=%.6fV, DAC=%.6fV (off=%.6fV idx=%d) → OUT_est=%.6fV\r\n",
                (double)t,
                (double)v_raw,
                (double)v_dac2,
                (double)o2,
                oi2,
                (double)(v_dac2 * OPAMP_GAIN)
            );

            __delay_ms(DEMO_OUTPUT_HOLD_MS);
        }
    }
}

