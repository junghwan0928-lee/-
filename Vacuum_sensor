/* 내부 온도센서용 Config (TS_MODE=1) */
static uint16_t SGM_BuildConfig1_TS(bool singleShot, bool start_now)
{
    uint16_t cfg = 0;

    cfg |= ((uint16_t)0u                  << 12); // MUX는 의미 없음
    cfg |= ((uint16_t)(SGM_PGA_2V048 & 0x7)<< 9 ); // PGA[2:0]
    cfg |= ((uint16_t)(singleShot ? 1u:0u)<< 8 ); // MODE
    cfg |= ((uint16_t)(SGM_DR_100SPS & 0x7)<< 5 ); // DR[2:0]
    cfg |= ((uint16_t)1u                  << 4 ); // TS_MODE = 1 (내부 온도센서)
    cfg |= ((uint16_t)1u                  << 3 ); // PULL_UP_EN = 1
    cfg |= ((uint16_t)0b01u               << 1 ); // NOP
    cfg |= 1u;

    if (start_now) {
        cfg |= (1u << 15);
    }
    return cfg;
}
#endif

static uint16_t SGM_BuildConfig2(void)
{
    uint16_t cfg=0;
    cfg |= (0x4u << 12);  // ID[3:0] = 0100 (default)
    cfg |= (0x0u << 9 );  // ID_VER[2:0] = 000
    cfg |= (0b01u<< 7 );  // NOP[1:0] = 01
    cfg |= (0u    << 4 ); // Reserved
    cfg |= (0u    << 3 ); // CRC_EN = 0
    cfg |= (0u    << 1 ); // 50/60[1:0] = 00
    // D0(RES_FG)는 read-only
    return cfg;
}

static void SGM_Transfer64_SPI1(uint16_t cfg1, uint16_t cfg2, uint8_t rx[8])
{
    uint8_t tx[8] = {
        (uint8_t)(cfg1>>8),(uint8_t)cfg1,
        (uint8_t)(cfg1>>8),(uint8_t)cfg1,
        (uint8_t)(cfg2>>8),(uint8_t)cfg2,
        (uint8_t)(cfg2>>8),(uint8_t)cfg2
    };
    SPI1_SetFor_SGM();
    for(int i=0;i<8;i++) rx[i] = SPI1_Exchange8bit(tx[i]);
}

static bool SGM_Wait_DRDY_Timeout(uint16_t timeout_ms)
{
    uint32_t us = (uint32_t)timeout_ms * 1000u;
    while (SGM_DRDY_PORT != 0 && us--) {
        __delay_us(1);
    }
    return (us > 0);
}

static inline int32_t signext24(uint32_t w){
    int32_t v = (int32_t)(w & 0xFFFFFFu);
    if(v & 0x800000) v |= ~0xFFFFFF;
    return v;
}

static void SGM_Init_SingleShot(void)
{
    if (g_sgm_inited) return;
    g_sgm_cfg2 = SGM_BuildConfig2();
    g_sgm_inited = true;
}

/* 단일 변환: MUX 선택 후 single-shot 변환 1번 수행 (일반 ADC) */
static bool SGM_ReadSingle_ADC(uint8_t mux_sel,
                               int32_t *dec_out,
                               float   *volts_out)
{
    if (!g_sgm_inited) {
        SGM_Init_SingleShot();
    }

    uint8_t rx[8];

    /* 1) 변환 시작 (SS=1). 첫 번째 수신 데이터는 이전 결과이므로 버림. */
    uint16_t cfg_start = SGM_BuildConfig1_ADC(mux_sel, true, true);
    SGM_Transfer64_SPI1(cfg_start, g_sgm_cfg2, rx);

    /* 2) DRDY Low까지 대기 */
    if (!SGM_Wait_DRDY_Timeout(50)) {
        return false;
    }

    /* 3) 결과 읽기 (SS=0, 다음 변환은 시작하지 않음) */
    uint16_t cfg_read = SGM_BuildConfig1_ADC(mux_sel, true, false);
    SGM_Transfer64_SPI1(cfg_read, g_sgm_cfg2, rx);

    /* 4) 24bit ADC 결과 파싱 */
    uint32_t raw24u = ((uint32_t)rx[0]<<16) | ((uint32_t)rx[1]<<8) | rx[4];
    int32_t  dec    = signext24(raw24u);

    if (dec_out)   *dec_out   = dec;
    if (volts_out) *volts_out = dec * (SGM_PGA / 8388608.0f); // ±2.048V / 2^23

    return true;
}


#if SGM_TEMP_ENABLE
/* 내부 온도센서(보정된 °C 값) 읽기
 *  - 데이터시트:
 *    * 14-bit two's complement
 *    * 24bit 결과의 상위 14bit가 온도 코드
 *    * 두 바이트(rx[0], rx[1])에서 상위 14bit 사용 (좌측 정렬)
 *    * 1 LSB = 0.03125°C
 */
static bool SGM_Read_Temp(int32_t *dec_out, float *tempC_out)
{
    if (!g_sgm_inited) {
        SGM_Init_SingleShot();
    }

    uint8_t rx[8];

    /* 1) 온도센서 모드로 변환 시작 */
    uint16_t cfg_start = SGM_BuildConfig1_TS(true, true);
    SGM_Transfer64_SPI1(cfg_start, g_sgm_cfg2, rx);

    /* 2) DRDY 대기 */
    if (!SGM_Wait_DRDY_Timeout(50)) {
        return false;
    }

    /* 3) 결과 읽기 */
    uint16_t cfg_read = SGM_BuildConfig1_TS(true, false);
    SGM_Transfer64_SPI1(cfg_read, g_sgm_cfg2, rx);

    /* 온도 데이터:
     *  - 24bit 결과의 상위 14bit가 온도 코드
     *  - 두 바이트(rx[0], rx[1])에서 상위 14bit → 하위 2bit는 버림
     */
    uint16_t raw16     = ((uint16_t)rx[0] << 8) | rx[1];
    uint16_t code14_u  = (raw16 >> 2);          // 상위 14bit만 남김 (bits 15:2)

    /* 14-bit 두's complement sign-extend */
    int16_t code14 = (int16_t)code14_u;
    if (code14 & 0x2000) {                      // bit13가 부호비트
        code14 |= 0xC000;                       // 상위 2비트(15:14)를 1로 채워서 sign-extend
    }

    if (dec_out) {
        *dec_out = (int32_t)code14;             // 원시 온도 코드(14bit sign-extended)
    }

    if (tempC_out) {
        /* 1 LSB = 0.03125°C → 실제 온도 */
        *tempC_out = (float)code14 * 0.03125f;
    }

    return true;
}
#endif





/* 선형/로그 보간 선택(기본 선형) */
#define TORR_INTERP_MODE_LOG     0
#define TORR_INTERP_MODE_LINEAR  1
#ifndef TORR_INTERP_MODE
#define TORR_INTERP_MODE TORR_INTERP_MODE_LINEAR
#endif

static float estimate_torr_from_dec(int32_t dec)
{
    if (g_decLutCount < 2) {
        return clampf((g_decLutCount>0 ? g_decLut[0].torr : TORR_EST_MIN),
                      TORR_EST_MIN, TORR_EST_MAX);
    }
    for (int i = 0; i < g_decLutCount - 1; ++i) {
        int32_t d0 = g_decLut[i].dec,   d1 = g_decLut[i+1].dec;
        float   t0 = g_decLut[i].torr,  t1 = g_decLut[i+1].torr;

        int32_t dmin = (d0 < d1) ? d0 : d1;
        int32_t dmax = (d0 > d1) ? d0 : d1;

        if (dec >= dmin && dec <= dmax) {
            int32_t denom = (d1 - d0);
            if (denom == 0) return clampf(t0, TORR_EST_MIN, TORR_EST_MAX);

            float t = (float)(dec - d0) / (float)denom;
#if (TORR_INTERP_MODE == TORR_INTERP_MODE_LOG)
            if (t0 <= 0.0f || t1 <= 0.0f) {
                float Torr_lin = (1.0f - t) * t0 + t * t1;
                return clampf(Torr_lin, TORR_EST_MIN, TORR_EST_MAX);
            }
            float logT = (1.0f - t) * log10f(t0) + t * log10f(t1);
            float Torr = powf(10.0f, logT);
            return clampf(Torr, TORR_EST_MIN, TORR_EST_MAX);
#else
            float Torr = (1.0f - t) * t0 + t * t1;
            return clampf(Torr, TORR_EST_MIN, TORR_EST_MAX);
#endif
        }
    }
    if ((g_decLut[0].dec < g_decLut[g_decLutCount-1].dec && dec < g_decLut[0].dec) ||
        (g_decLut[0].dec > g_decLut[g_decLutCount-1].dec && dec > g_decLut[0].dec)) {
        return clampf(g_decLut[0].torr, TORR_EST_MIN, TORR_EST_MAX);
    } else {
        return clampf(g_decLut[g_decLutCount-1].torr, TORR_EST_MIN, TORR_EST_MAX);
    }
}


/* =================================================================
 * Torr → DAC 전압 (이론값, offset 적용 전)
 * ================================================================= */
static float torr_to_vdac(float p_torr, bool* cl_lo, bool* cl_hi)
{
    if (cl_lo) *cl_lo = false;
    if (cl_hi) *cl_hi = false;

    float p = p_torr;
    if (p < TORR_DAC_MIN) { p = TORR_DAC_MIN; if (cl_lo) *cl_lo = true; }
    if (p > TORR_DAC_MAX) { p = TORR_DAC_MAX; if (cl_hi) *cl_hi = true; }

    float vopamp_target = p * TORR_TO_OPAMP_V_PER_TORR; // 0.01 V/Torr
    float vdac = vopamp_target / OPAMP_GAIN;
    return clampf(vdac, 0.0f, VREF_V);
}


/* =================================================================
 * RAW 필터 (미디언 + EMA 조합)
 * ================================================================= */
#define DEC_DEADBAND_COUNTS  0

static int32_t  g_dec_ema        = 0;
static bool     g_dec_emaInit    = false;
static int32_t  g_dec_lastReturn = 0;
static bool     g_dec_lastInit   = false;
static bool     g_filter_active  = false;
static uint32_t g_elapsed_ms     = 0;
static uint16_t g_raw_discard_remaining = RAW_DISCARD_COUNT;

#if RAW_MEDIAN_ENABLE

static int32_t g_median_buf[RAW_MEDIAN_WINDOW] = {0};
static uint8_t g_median_count = 0;
static uint8_t g_median_idx   = 0;

/* 작은 윈도우(3~5)용 간단 정렬 함수 */
static void sort_int32_small(int32_t* a, uint8_t n)
{
    for (uint8_t i = 0; i < n; ++i) {
        for (uint8_t j = i + 1; j < n; ++j) {
            if (a[j] < a[i]) {
                int32_t tmp = a[i];
                a[i] = a[j];
                a[j] = tmp;
            }
        }
    }
}

static int32_t apply_median_filter(int32_t x)
{
    g_median_buf[g_median_idx] = x;
    g_median_idx++;
    if (g_median_idx >= RAW_MEDIAN_WINDOW) {
        g_median_idx = 0;
    }
    if (g_median_count < RAW_MEDIAN_WINDOW) {
        g_median_count++;
        /* 아직 윈도우가 다 안 찼으면 원본 값 그대로 반환 */
        return x;
    }

    int32_t tmp[RAW_MEDIAN_WINDOW];
    for (uint8_t i = 0; i < RAW_MEDIAN_WINDOW; ++i) {
        tmp[i] = g_median_buf[i];
    }
    sort_int32_small(tmp, RAW_MEDIAN_WINDOW);

    /* 중앙값 반환 */
    return tmp[RAW_MEDIAN_WINDOW / 2];
}

#endif

static int32_t filter_dec_core(int32_t x)
{
#if (DEC_FILTER_MODE == FILTER_MODE_NONE)
    return x;

#elif (DEC_FILTER_MODE == FILTER_MODE_EMA)
    if (!g_dec_emaInit) { g_dec_ema = x; g_dec_emaInit = true; }
    else {
        float y = (1.0f - EMA_ALPHA_BASE) * (float)g_dec_ema + EMA_ALPHA_BASE * (float)x;
        g_dec_ema = (int32_t)lrintf(y);
    }
    return g_dec_ema;

#elif (DEC_FILTER_MODE == FILTER_MODE_FASA_EMA)
    if (!g_dec_emaInit) { g_dec_ema = x; g_dec_emaInit = true; }
    else {
        float alpha = (x > g_dec_ema) ? EMA_ALPHA_UP : EMA_ALPHA_DOWN;
        float y = (1.0f - alpha) * (float)g_dec_ema + alpha * (float)x;
        g_dec_ema = (int32_t)lrintf(y);
    }
    return g_dec_ema;

#elif (DEC_FILTER_MODE == FILTER_MODE_SRL_EMA)
    if (!g_dec_emaInit) { g_dec_ema = x; g_dec_emaInit = true; }
    else {
        int32_t prev = g_dec_ema;
        int32_t dx   = x - prev;
        if (dx >  SRL_MAX_STEP_COUNTS) dx =  SRL_MAX_STEP_COUNTS;
        if (dx < -SRL_MAX_STEP_COUNTS) dx = -SRL_MAX_STEP_COUNTS;
        int32_t limited = prev + dx;
        float y = (1.0f - EMA_ALPHA_BASE) * (float)prev + EMA_ALPHA_BASE * (float)limited;
        g_dec_ema = (int32_t)lrintf(y);
    }
    return g_dec_ema;
#else
    return x;
#endif
}

static int32_t filter_dec_with_delay(int32_t dec_in)
{
    if (!g_filter_active) {
        g_dec_ema        = dec_in;
        g_dec_emaInit    = true;
        g_dec_lastReturn = dec_in;
        g_dec_lastInit   = true;
        return dec_in;
    }

    int32_t x = dec_in;

#if RAW_MEDIAN_ENABLE
    /* 먼저 median 3/5로 스파이크 제거 */
    x = apply_median_filter(x);
#endif

    if (g_dec_lastInit) {
        int32_t d = x - g_dec_lastReturn; if (d < 0) d = -d;
        if (d <= DEC_DEADBAND_COUNTS) x = g_dec_lastReturn;
    }
    int32_t y = filter_dec_core(x);
    g_dec_lastReturn = y;
    g_dec_lastInit   = true;
    return y;
}


